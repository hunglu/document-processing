# ── Build stage ──────────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/sdk:8.0-alpine AS build
WORKDIR /src

# Restore only what changed (layer cache optimisation)
COPY ["src/DocumentProcessing.Contracts/DocumentProcessing.Contracts.csproj",   "src/DocumentProcessing.Contracts/"]
COPY ["src/DocumentProcessing.Core/DocumentProcessing.Core.csproj",             "src/DocumentProcessing.Core/"]
COPY ["src/DocumentProcessing.Infrastructure/DocumentProcessing.Infrastructure.csproj", "src/DocumentProcessing.Infrastructure/"]
COPY ["src/DocumentProcessing.Api/DocumentProcessing.Api.csproj",               "src/DocumentProcessing.Api/"]
RUN dotnet restore "src/DocumentProcessing.Api/DocumentProcessing.Api.csproj" --runtime linux-musl-x64

# Build
COPY . .
RUN dotnet build "src/DocumentProcessing.Api/DocumentProcessing.Api.csproj" \
    -c Release \
    --runtime linux-musl-x64 \
    --self-contained false \
    --no-restore \
    -o /app/build

# Publish
FROM build AS publish
RUN dotnet publish "src/DocumentProcessing.Api/DocumentProcessing.Api.csproj" \
    -c Release \
    --runtime linux-musl-x64 \
    --self-contained false \
    --no-build \
    -o /app/publish

# ── Runtime stage ─────────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/aspnet:8.0-alpine AS final
WORKDIR /app

# Non-root user for security
RUN addgroup -S appgroup && adduser -S appuser -G appgroup
USER appuser

# Expose port 8080 (not 443 — TLS terminated at ingress/CDN)
EXPOSE 8080

ENV ASPNETCORE_URLS=http://+:8080
ENV ASPNETCORE_ENVIRONMENT=Production
ENV DOTNET_RUNNING_IN_CONTAINER=true

COPY --from=publish /app/publish .

ENTRYPOINT ["dotnet", "DocumentProcessing.Api.dll"]
