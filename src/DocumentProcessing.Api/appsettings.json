{
  "AllowedHosts": "*",
  "AllowedOrigins": [],

  "ConnectionStrings": {
    "DefaultConnection": "@Microsoft.KeyVault(SecretUri=https://kv-docprocessing.vault.azure.net/secrets/SqlConnectionString/)"
  },

  "Redis": {
    "ConnectionString": "@Microsoft.KeyVault(SecretUri=https://kv-docprocessing.vault.azure.net/secrets/RedisConnectionString/)",
    "DefaultTtlMinutes": 60,
    "PageUrlTtlMinutes": 55
  },

  "Azure": {
    "BlobStorage": {
      "ConnectionString": "@Microsoft.KeyVault(SecretUri=https://kv-docprocessing.vault.azure.net/secrets/BlobStorageConnectionString/)",
      "DocsContainer": "docs",
      "PagesContainer": "pages",
      "SasTokenExpiryMinutes": 60,
      "CdnTokenExpiryMinutes": 60,
      "CdnEndpointBaseUrl": "https://docprocessing-cdn.azureedge.net"
    },
    "ServiceBus": {
      "ConnectionString": "@Microsoft.KeyVault(SecretUri=https://kv-docprocessing.vault.azure.net/secrets/ServiceBusConnectionString/)",
      "ProcessingQueueName": "document-processing-queue",
      "EventsTopicName": "document-events"
    }
  },

  "ApplicationInsights": {
    "ConnectionString": "@Microsoft.KeyVault(SecretUri=https://kv-docprocessing.vault.azure.net/secrets/AppInsightsConnectionString/)"
  },

  "DataDog": {
    "ServiceName": "document-processing-api",
    "OtlpEndpoint": "http://localhost:4317"
  },

  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.ApplicationInsights",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Thread"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "ApplicationInsights",
        "Args": {
          "connectionString": "@Microsoft.KeyVault(SecretUri=https://kv-docprocessing.vault.azure.net/secrets/AppInsightsConnectionString/)",
          "telemetryConverter": "Serilog.Sinks.ApplicationInsights.TelemetryConverters.TraceTelemetryConverter, Serilog.Sinks.ApplicationInsights"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "DocumentProcessing.Api"
    }
  }
}
