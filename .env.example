# SQL Server SA password — used by SQL Server container and Service Bus Emulator
SQL_SA_PASSWORD=Your_password123!

# Application Insights (dummy value is fine for local dev)
APPINSIGHTS_CONNECTION_STRING=InstrumentationKey=00000000-0000-0000-0000-000000000000

# DataDog — only needed when running with --profile monitoring
DD_API_KEY=your_datadog_api_key_here
DD_SITE=datadoghq.com
